// SPDX-License-Identifier: Apache-2.0
// ICSLab FPGA Programmer - Windows resources

#include <winver.h>
#include <winuser.h>
#include "../src/resource.h"

IDI_APPICON ICON "icslab.ico"

CREATEPROCESS_MANIFEST_RESOURCE_ID RT_MANIFEST "app.manifest"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION    ICSLAB_VERSION_MAJOR,ICSLAB_VERSION_MINOR,ICSLAB_VERSION_PATCH,0
 PRODUCTVERSION ICSLAB_VERSION_MAJOR,ICSLAB_VERSION_MINOR,ICSLAB_VERSION_PATCH,0
 FILEFLAGSMASK  0x3fL
 FILEFLAGS      0x0L
 FILEOS         VOS_NT_WINDOWS32
 FILETYPE       VFT_APP
 FILESUBTYPE    0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "ICSLab"
            VALUE "Author",           "ICSLab"
            VALUE "FileDescription",  "Simple FPGA programming utility powered by openFPGALoader"
            VALUE "FileVersion",      ICSLAB_VERSION_STR
            VALUE "InternalName",     "ICSLabFPGAProgrammer"
            VALUE "LegalCopyright",   "Copyright (C) ICSLab. Uses openFPGALoader (Apache-2.0), an independent open-source project."
            VALUE "OriginalFilename", "ICSLab FPGA Programmer.exe"
            VALUE "ProductName",      "ICSLab FPGA Programmer"
            VALUE "ProductVersion",   ICSLAB_VERSION_STR
            VALUE "Comments",         "ICSLab FPGA Programmer uses openFPGALoader as its FPGA programming backend. openFPGALoader is an independent open-source project: https://github.com/trabucayre/openFPGALoader"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
